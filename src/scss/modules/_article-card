.article-card {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: subgrid;
}

// ---------- Закрытая: колонки 9–12, высота 200px ----------
.article-card-toggle {
  grid-column: 9 / -1;
  grid-row: 1;

  appearance: none;
  position: relative;
  isolation: isolate; // слои смешиваются только внутри карточки
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  column-gap: 1rem;
  box-sizing: border-box;
  width: 100%;
  height: 12.5rem;
  margin: 0;
  padding: 0.75rem;
  overflow: hidden;
  border: none;
  background: var(
    --background-section-contrast
  ); // фон, с которым смешивается фото
  color: inherit;
  text-align: left;
  cursor: pointer;

  // слой 2: бежевый 50%, color-burn
  &::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--secondary-beige-50, rgb(240 238 223 / 0.5));
    mix-blend-mode: color-burn;
    pointer-events: none;
  }

  // слой 3: синий, color
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #4c53a2;
    mix-blend-mode: color;
    pointer-events: none;
  }

  &:focus-visible {
    outline: 2px solid var(--text-orange-light);
    outline-offset: 2px;
  }

  // заголовок
  .body-regular {
    position: relative;
    z-index: 4;
    align-self: start;
    text-transform: uppercase;
  }

  // дата
  time {
    position: relative;
    z-index: 4;
    grid-column: 2;
    align-self: end;
    justify-self: end;
    color: var(--text-orange-light);
  }
}

// слой 1: фото, luminosity
.article-card-thumb {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  mix-blend-mode: luminosity;
}

// слой 4: градиент сверху, чтобы читался заголовок
.article-card-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  background: linear-gradient(
    180deg,
    var(--background-section-contrast) 16.83%,
    transparent 45.4%
  );
  pointer-events: none;
}
// ---------- Открытая: вся ширина сетки ----------
.article-card.is-open > .article-card-toggle {
  display: none;
}

.article-card-open {
  grid-column: 1 / -1;
  grid-row: 1;
  display: grid;
  grid-template-columns: subgrid;
  height: 12.5rem;
  align-items: stretch;

  &[hidden] {
    display: none;
  }
}

.article-card-content {
  grid-column: 1 / 7;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 0.5rem;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  padding-left: 2.625rem;

  > .article-card-header,
  > .button-small {
    flex-shrink: 0;
  }

  > .body-regular {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2; // на узких экранах — 2 строки
    flex-shrink: 0; // не сжимать: высота = ровно N строк
    overflow: hidden;
    padding-top: 0.3em; // место для верха буквицы
    margin: -0.3em 0 0;
  }

  > .button-small {
    margin-top: 0.25rem; // итого 12px до кнопки, как в Figma
  }
}

.article-card-content > .body-regular {
  &::first-letter {
    initial-letter: 2; // буква высотой ровно в 2 строки
    margin-right: 0.5rem;
    color: var(--text-orange-light);
    font-family: "Akke Variable", serif;
    font-weight: 300;
  }
}

// заголовок и автор прижаты вправо, ширина 411 из 584
.article-card-header {
  align-self: flex-end;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  width: 70%;

  h4,
  p {
    margin: 0;
  }

  h4 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-transform: uppercase;
  }
}

// картинка: колонки 7–12
.article-card-img {
  grid-column: 7 / -1;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: bottom;
  mix-blend-mode: plus-lighter;
}
